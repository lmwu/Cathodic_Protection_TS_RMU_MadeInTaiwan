      "top": -260,
      "left": -200,
      "rotate": 270,
      "attrs": {}
    },
    {
      "type": "chip-ads1219",
      "id": "ads",
      "top": 160,
      "left": -300,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
