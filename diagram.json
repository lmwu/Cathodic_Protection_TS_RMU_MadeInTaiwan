{
  "version": 1,
  "author": "TS RMU Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "flashSize": "16" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_selftest",
      "top": -80,
      "left": 30,
      "attrs": { "color": "green", "label": "Self-Test" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_instantoff",
      "top": -80,
      "left": 130,
      "attrs": { "color": "red", "label": "Instant-Off" }
    },
    {
      "type": "wokwi-led",
      "id": "led_relay",
      "top": 20,
      "left": 130,
      "attrs": { "color": "red", "label": "Relay ON" }
    },
    {
      "type": "wokwi-resistor",
