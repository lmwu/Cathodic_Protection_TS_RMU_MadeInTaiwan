    {
      "type": "wokwi-text",
      "id": "lbl_coupon",
      "top": 120,             
      "left": -120,            
      "attrs": { "text": "試片 (接AIN1)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_bat",
      "top": 200,
      "left": -120,
      "attrs": { "label": "Bat Volt (AIN2)" }
