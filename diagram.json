  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "btn_selftest:1.l", "esp:1", "green", [] ],
    [ "btn_selftest:2.l", "esp:GND.2", "black", [] ],

    [ "btn_instantoff:1.l", "esp:2", "red", [] ],
    [ "btn_instantoff:2.l", "esp:GND.2", "black", [] ],

    [ "esp:7", "led_relay:A", "red", [] ],
    [ "led_relay:K", "r_relay_led:1", "black", [] ],
    [ "r_relay_led:2", "esp:GND.2", "black", [] ],

    [ "tft:VCC", "esp:3V3.1", "red", [] ],
    [ "tft:GND", "esp:GND.1", "black", [] ],
    [ "tft:CS", "esp:10", "orange", [] ],
    [ "tft:RST", "esp:14", "purple", [] ],
    [ "tft:D/C", "esp:9", "gray", [] ],
    [ "tft:MOSI", "esp:11", "blue", [] ],
    [ "tft:SCK", "esp:12", "yellow", [] ],
    [ "tft:LED", "esp:3V3.1", "red", [] ],
    [ "tft:MISO", "esp:13", "white", [] ],

    [ "ads:VDD", "esp:3V3.1", "red", [] ],
    [ "ads:GND", "esp:GND.1", "black", [] ],
    [ "ads:SDA", "esp:4", "blue", [] ],
    [ "ads:SCL", "esp:5", "yellow", [] ],

    [ "pot_pipe:VCC", "esp:3V3.1", "red", [] ],
    [ "pot_pipe:GND", "esp:GND.1", "black", [] ],
    [ "pot_pipe:SIG", "ads:AIN0", "green", [] ],

    [ "pot_coupon:VCC", "esp:3V3.1", "red", [] ],
    [ "pot_coupon:GND", "esp:GND.1", "black", [] ],
    [ "pot_coupon:SIG", "ads:AIN1", "cyan", [] ],

    [ "pot_bat:VCC", "esp:3V3.1", "red", [] ],
    [ "pot_bat:GND", "esp:GND.1", "black", [] ],
    [ "pot_bat:SIG", "ads:AIN2", "orange", [] ]
